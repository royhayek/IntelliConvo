{
  "name": "@intelliconvo/widget",
  "version": "1.0.0",
  "description": "IntelliConvo Widget - Embeddable chat widget",
  "main": "dist/widget.js",
  "scripts": {
    "dev": "webpack --mode development --watch",
    "build": "webpack --mode production",
    "preview": "npm run build && echo '\n✅ Production build ready!\n📂 Serving at: http://localhost:8080\n🔗 Open: http://localhost:8080/demo.html\n' && serve dist -l 8080",
    "serve": "webpack serve --mode development",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "type-check": "tsc --noEmit",
    "validate": "npm run lint && npm run type-check"
  },
  "dependencies": {
    "socket.io-client": "^4.7.4"
  },
  "devDependencies": {
    "@babel/core": "^7.23.6",
    "@babel/preset-env": "^7.23.6",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "autoprefixer": "^10.4.22",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.8.1",
    "css-minimizer-webpack-plugin": "^7.0.2",
    "cssnano": "^7.1.2",
    "dotenv": "^17.2.3",
    "dotenv-webpack": "^8.1.1",
    "eslint": "^9.39.1",
    "html-webpack-plugin": "^5.6.0",
    "open-cli": "^8.0.0",
    "postcss-loader": "^8.2.0",
    "style-loader": "^3.3.3",
    "terser-webpack-plugin": "^5.3.14",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "webpack": "^5.89.0",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  }
}
