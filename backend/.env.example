# Database
DATABASE_URL="postgresql://user:password@localhost:5432/intelligentconvo?schema=public"
REDIS_URL="redis://localhost:6379"

# Server
PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Pinecone
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=your-pinecone-environment
PINECONE_INDEX_NAME=intelligentconvo-embeddings
# Dimension must match your Pinecone index (512, 1024, or 1536 for text-embedding-3-small)
PINECONE_DIMENSIONS=512

# Stripe
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
STRIPE_PRICE_MONTHLY=price_monthly_id
STRIPE_PRICE_ANNUAL=price_annual_id

# Payment Testing
# Set to 'true' to bypass Stripe and simulate successful payments (for development/testing)
TEST_PAYMENT_MODE=false

# URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
WIDGET_CDN_URL=http://localhost:8080

# Email
SENDGRID_API_KEY=your-sendgrid-api-key
FROM_EMAIL=noreply@intelligentconvo.ai

# Storage
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=intelligentconvo-uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100