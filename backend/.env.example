# ==========================================
# INTELLIGENTCONVO BACKEND CONFIGURATION
# ==========================================
# Copy this file to .env and fill in your values
# Never commit .env to version control!
#
# REQUIRED fields are marked with [REQUIRED]
# OPTIONAL fields are marked with [OPTIONAL]

# ==========================================
# SERVER CONFIGURATION
# ==========================================

# Node environment (development, production, test) [REQUIRED]
NODE_ENV=development

# Server port [REQUIRED]
PORT=5000

# ==========================================
# DATABASE CONFIGURATION
# ==========================================

# PostgreSQL connection string [REQUIRED]
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Example: postgresql://postgres:password@localhost:5432/intelligentconvo
DATABASE_URL=postgresql://postgres:password@localhost:5432/intelligentconvo

# ==========================================
# REDIS CONFIGURATION
# ==========================================
# Redis is used for:
# - Background job queues (BullMQ)
# - JWT token blacklist
# - Caching (optional)

# Redis host [REQUIRED]
REDIS_HOST=localhost

# Redis port [REQUIRED]
REDIS_PORT=6379

# Redis password [OPTIONAL] (leave empty if no password)
REDIS_PASSWORD=

# Legacy Redis URL format (deprecated, use above instead)
# REDIS_URL=redis://localhost:6379

# ==========================================
# JWT AUTHENTICATION
# ==========================================

# JWT secret key [REQUIRED]
# ⚠️ MUST be at least 32 characters for security!
# Generate a secure random string: openssl rand -base64 32
# Example: this-is-a-super-secure-secret-key-with-at-least-32-characters
JWT_SECRET=your-super-secure-jwt-secret-key-minimum-32-characters-required

# Access token expiration time (default: 7d) [OPTIONAL]
# Examples: 60, "2 days", "10h", "7d"
JWT_EXPIRES_IN=7d

# Refresh token expiration time (default: 30d) [OPTIONAL]
JWT_REFRESH_EXPIRES_IN=30d

# ==========================================
# OPENAI CONFIGURATION
# ==========================================

# OpenAI API key [REQUIRED]
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI model for chat completions (default: gpt-4-turbo-preview) [OPTIONAL]
# Options: gpt-4-turbo-preview, gpt-4, gpt-3.5-turbo
OPENAI_MODEL=gpt-4-turbo-preview

# OpenAI embedding model (default: text-embedding-3-small) [OPTIONAL]
# Options: text-embedding-3-small, text-embedding-3-large, text-embedding-ada-002
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ==========================================
# PINECONE VECTOR DATABASE
# ==========================================

# Pinecone API key [REQUIRED]
# Get your key from: https://www.pinecone.io/
PINECONE_API_KEY=your-pinecone-api-key-here

# Pinecone index name (default: intelligentconvo) [REQUIRED]
PINECONE_INDEX_NAME=intelligentconvo

# Pinecone embedding dimensions [REQUIRED]
# ⚠️ MUST match your Pinecone index configuration!
# text-embedding-3-small supports: 512, 1536
# text-embedding-3-large supports: 256, 1024, 3072
PINECONE_DIMENSIONS=512

# Legacy Pinecone environment (deprecated in newer versions)
# PINECONE_ENVIRONMENT=us-east-1-aws

# ==========================================
# FRONTEND & WIDGET URLS
# ==========================================

# Frontend application URL [REQUIRED]
# Used for CORS and OAuth redirects
FRONTEND_URL=http://localhost:3000

# Backend URL [OPTIONAL]
# Used for internal references
BACKEND_URL=http://localhost:5000

# Widget CDN URL [OPTIONAL]
# Used for CORS if widget is hosted separately
WIDGET_CDN_URL=http://localhost:8080

# ==========================================
# OAUTH PROVIDERS
# ==========================================
# All OAuth providers are optional
# If credentials are not provided, that OAuth method will be disabled

# Google OAuth [OPTIONAL]
# Get credentials from: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth [OPTIONAL]
# Get credentials from: https://github.com/settings/developers
# Authorization callback URL: http://localhost:5000/api/auth/github/callback
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Microsoft OAuth [OPTIONAL] (currently not implemented in code)
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret

# ==========================================
# STRIPE PAYMENT PROCESSING
# ==========================================
# All Stripe settings are optional
# If not provided, billing features will be disabled

# Stripe secret key [OPTIONAL]
# Get from: https://dashboard.stripe.com/apikeys
# Use test key (sk_test_...) for development
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key

# Stripe webhook secret [OPTIONAL]
# Get from: https://dashboard.stripe.com/webhooks
# Required for webhook signature verification
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Stripe price IDs for subscription plans [OPTIONAL]
STRIPE_PREMIUM_MONTHLY_PRICE_ID=price_your_monthly_price_id
STRIPE_PREMIUM_ANNUAL_PRICE_ID=price_your_annual_price_id

# Legacy Stripe price fields (deprecated, use above instead)
# STRIPE_PRICE_MONTHLY=price_monthly_id
# STRIPE_PRICE_ANNUAL=price_annual_id

# Payment Testing Mode [OPTIONAL]
# Set to 'true' to bypass Stripe and simulate successful payments
# ⚠️ ONLY for development/testing - NEVER use in production!
TEST_PAYMENT_MODE=false

# ==========================================
# RATE LIMITING
# ==========================================

# Global rate limit window in milliseconds (default: 60000 = 1 minute) [OPTIONAL]
RATE_LIMIT_WINDOW_MS=60000

# Global rate limit max requests per window (default: 100) [OPTIONAL]
RATE_LIMIT_MAX_REQUESTS=100

# Auth rate limit window in milliseconds (default: 900000 = 15 minutes) [OPTIONAL]
AUTH_RATE_LIMIT_WINDOW_MS=900000

# Auth rate limit max requests per window (default: 5) [OPTIONAL]
AUTH_RATE_LIMIT_MAX_REQUESTS=5

# ==========================================
# FILE UPLOADS
# ==========================================

# Maximum file upload size (default: 10mb) [OPTIONAL]
# Examples: 5mb, 10mb, 50mb, 100mb
MAX_FILE_SIZE=10mb

# Upload directory (default: uploads) [OPTIONAL]
UPLOAD_DIR=uploads

# ==========================================
# EMAIL (SendGrid)
# ==========================================
# Optional - for email notifications

# SendGrid API key [OPTIONAL]
SENDGRID_API_KEY=your-sendgrid-api-key

# From email address [OPTIONAL]
FROM_EMAIL=noreply@intelligentconvo.ai

# ==========================================
# CLOUD STORAGE (AWS S3)
# ==========================================
# Optional - for cloud file storage
# If not provided, files are stored locally

# AWS credentials [OPTIONAL]
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1

# S3 bucket name [OPTIONAL]
S3_BUCKET_NAME=intelligentconvo-uploads

# ==========================================
# LOGGING & MONITORING
# ==========================================

# Log level [OPTIONAL] (error, warn, info, http, debug)
# Production: warn or info, Development: debug
LOG_LEVEL=debug

# Enable Swagger API documentation [OPTIONAL]
# Automatically disabled in production
ENABLE_SWAGGER=true

# ==========================================
# ADVANCED SETTINGS (Optional)
# ==========================================

# Database connection pool size [OPTIONAL]
# DATABASE_POOL_SIZE=10

# Request timeout in milliseconds [OPTIONAL]
# REQUEST_TIMEOUT=30000

# Enable detailed error stack traces [OPTIONAL]
# ENABLE_ERROR_STACK=false

# ==========================================
# EXAMPLE: MINIMAL WORKING CONFIGURATION
# ==========================================
# This is the absolute minimum to get started:
#
# NODE_ENV=development
# PORT=5000
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/intelligentconvo
# REDIS_HOST=localhost
# REDIS_PORT=6379
# JWT_SECRET=this-is-a-super-secure-secret-key-with-at-least-32-characters
# OPENAI_API_KEY=sk-proj-your-key-here
# PINECONE_API_KEY=your-pinecone-key-here
# PINECONE_INDEX_NAME=intelligentconvo
# PINECONE_DIMENSIONS=512
# FRONTEND_URL=http://localhost:3000

# ==========================================
# SECURITY NOTES
# ==========================================
#
# 1. JWT_SECRET MUST be at least 32 characters
# 2. Never commit .env file to version control
# 3. Use different credentials for development and production
# 4. Rotate secrets regularly in production
# 5. Use strong, randomly generated passwords
# 6. Enable 2FA for all external services (OpenAI, Pinecone, Stripe)
# 7. Keep dependencies updated
# 8. Use environment-specific Redis instances
# 9. Monitor rate limits and adjust as needed
# 10. Review and audit access logs regularly

# ==========================================
# PRODUCTION DEPLOYMENT CHECKLIST
# ==========================================
#
# Before deploying to production, ensure:
# [ ] NODE_ENV is set to "production"
# [ ] JWT_SECRET is a strong random string (32+ characters, unique per environment)
# [ ] DATABASE_URL points to production database with SSL
# [ ] REDIS_HOST and REDIS_PASSWORD are configured for production
# [ ] All API keys are production keys (not test keys)
# [ ] FRONTEND_URL is set to production domain (https)
# [ ] OAuth redirect URIs are updated in provider dashboards
# [ ] Stripe webhook endpoint is configured and verified
# [ ] Rate limits are appropriately configured for production load
# [ ] Database backups are enabled and tested
# [ ] Monitoring and alerts are configured (uptime, errors, performance)
# [ ] SSL/TLS certificates are valid and auto-renewing
# [ ] CORS origins are properly restricted
# [ ] Logs are being collected and stored securely
# [ ] Error tracking is configured (e.g., Sentry)
# [ ] Load testing has been performed
# [ ] Security audit has been completed
# [ ] Disaster recovery plan is documented
# [ ] Team has access to production secrets via secret manager

# ==========================================
# TROUBLESHOOTING
# ==========================================
#
# Application won't start:
# - Check JWT_SECRET is at least 32 characters
# - Verify DATABASE_URL is correct and database is running
# - Ensure Redis is running and accessible
# - Check all REQUIRED fields are filled
#
# Authentication not working:
# - Verify JWT_SECRET is consistent
# - Check Redis is running (for token blacklist)
# - Ensure OAuth credentials are correct
# - Verify redirect URIs match provider settings
#
# AI chat not working:
# - Verify OPENAI_API_KEY is valid
# - Check PINECONE_API_KEY is valid
# - Ensure PINECONE_DIMENSIONS matches your index
# - Verify you have credits in OpenAI account
#
# Rate limiting issues:
# - Adjust RATE_LIMIT_MAX_REQUESTS if needed
# - Check AUTH_RATE_LIMIT_MAX_REQUESTS for auth endpoints
# - Monitor logs for rate limit hits
#
# For more help, see: https://github.com/your-repo/docs
