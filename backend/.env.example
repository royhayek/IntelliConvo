# ==========================================
# INTELLIGENTCONVO BACKEND CONFIGURATION
# ==========================================
# Copy this file to .env and fill in your values
# Never commit .env to version control!
#
# [REQUIRED] = Must be set as environment variables (secrets/infrastructure)
# [DB_MANAGED] = Now configurable from Admin Settings page
#                Environment variables are optional fallbacks only

# ==========================================
# SERVER CONFIGURATION [REQUIRED]
# ==========================================

NODE_ENV=development
PORT=5001

# ==========================================
# DATABASE CONFIGURATION [REQUIRED]
# ==========================================

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/intelligentconvo

# ==========================================
# REDIS CONFIGURATION [REQUIRED]
# ==========================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==========================================
# JWT AUTHENTICATION [REQUIRED]
# ==========================================

# JWT secret - MUST be at least 32 characters!
# Generate: openssl rand -base64 32
JWT_SECRET=your-super-secure-jwt-secret-key-minimum-32-characters-required

# ==========================================
# OPENAI CONFIGURATION [REQUIRED]
# ==========================================

# API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# ==========================================
# PINECONE VECTOR DATABASE [REQUIRED]
# ==========================================

PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX_NAME=intelligentconvo
PINECONE_DIMENSIONS=512

# ==========================================
# FRONTEND & WIDGET URLS [REQUIRED]
# ==========================================

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5001
WIDGET_CDN_URL=http://localhost:8080

# ==========================================
# OAUTH PROVIDERS [OPTIONAL]
# ==========================================

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ==========================================
# STRIPE PAYMENT PROCESSING [OPTIONAL]
# ==========================================

# Use sk_test_ keys for development
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_PRICE_MONTHLY=price_your_monthly_price_id
STRIPE_PRICE_ANNUAL=price_your_annual_price_id

# ==========================================
# EMAIL PROVIDER [OPTIONAL]
# ==========================================
# Choose one email provider. The system auto-detects based on which API key is set.
# Priority: Resend > Nodemailer/SMTP > Console (development only)

# Option 1: Resend (Recommended - Modern API, 3,000 free emails/month)
# Sign up at https://resend.com
RESEND_API_KEY=

# Option 2: SMTP (Nodemailer) - For custom SMTP servers, SendGrid SMTP, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Option 3: SendGrid API (Legacy - use SMTP or Resend instead)
SENDGRID_API_KEY=

# Email sender defaults (can also be configured in Admin Settings)
EMAIL_FROM_ADDRESS=noreply@intelligentconvo.ai
EMAIL_FROM_NAME=IntelligentConvo

# ==========================================
# CLOUD STORAGE - AWS S3 [OPTIONAL]
# ==========================================
# When configured, files will be uploaded to S3 instead of local storage
# If not configured, files will be stored locally in uploads/ directory

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_S3_PUBLIC_URL=  # Optional: Custom CDN URL (e.g., https://cdn.yourdomain.com)

# ==========================================
# LOGGING [OPTIONAL]
# ==========================================

LOG_LEVEL=debug
ENABLE_SWAGGER=true

# ==========================================
# DATABASE-MANAGED SETTINGS
# ==========================================
# The following settings are now managed via the Admin Settings page
# at /admin/settings and stored in the SystemSetting database table.
#
# After running `npx prisma db seed`, default values are created.
# You can modify them at runtime without restarting the server.
#
# Environment variables below are OPTIONAL FALLBACKS only - they will
# be used if the database setting doesn't exist or DB is unavailable.
#
# ----------------------------------------
# AI Settings (Admin > Settings > AI):
#   - ai.defaultModel (gpt-4-turbo-preview, gpt-4, gpt-3.5-turbo)
#   - ai.embeddingModel (text-embedding-3-small, text-embedding-3-large)
#   - ai.maxTokens (default: 4096)
#   - ai.temperature (0-2, default: 0.7)
#
# Security Settings (Admin > Settings > Security):
#   - security.sessionTimeoutDays (default: 7)
#   - security.refreshTokenDays (default: 30)
#   - security.maxLoginAttempts (default: 5)
#
# Rate Limiting (Admin > Settings > Rate Limiting):
#   - rateLimit.windowMs (default: 60000 ms = 1 min)
#   - rateLimit.maxRequests (default: 100)
#   - rateLimit.authWindowMs (default: 900000 ms = 15 min)
#   - rateLimit.authMaxRequests (default: 5)
#
# Email Settings (Admin > Settings > Email):
#   - email.fromAddress (default: noreply@intelligentconvo.ai)
#   - email.fromName (default: IntelligentConvo)
#
# Billing Settings (Admin > Settings > Billing):
#   - billing.trialDays (default: 14)
#   - billing.currency (default: USD)
#
# Storage Settings (Admin > Settings > Storage):
#   - storage.maxFileSizeMb (default: 10)
#   - storage.uploadDir (default: uploads)
#
# General Settings (Admin > Settings > General):
#   - general.platformName (default: IntelligentConvo)
#   - general.supportEmail (default: support@intelligentconvo.com)
#   - general.maintenanceMode (default: false)
# ----------------------------------------
#
# To override DB settings via env vars (not recommended), uncomment:
# OPENAI_MODEL=gpt-4-turbo-preview
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_REQUESTS=100
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX_REQUESTS=5
# MAX_FILE_SIZE=10mb
# UPLOAD_DIR=uploads
# FROM_EMAIL=noreply@intelligentconvo.ai

# ==========================================
# QUICK START (Minimum Required)
# ==========================================
#
# NODE_ENV=development
# PORT=5001
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/intelligentconvo
# REDIS_HOST=localhost
# REDIS_PORT=6379
# JWT_SECRET=generate-with-openssl-rand-base64-32
# OPENAI_API_KEY=sk-your-key
# PINECONE_API_KEY=your-pinecone-key
# PINECONE_INDEX_NAME=intelligentconvo
# PINECONE_DIMENSIONS=512
# FRONTEND_URL=http://localhost:3000
